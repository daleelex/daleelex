{
  "name": "daleelex",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "pnpm --filter @daleelex/api prisma migrate dev",
    "db:seed": "pnpm --filter @daleelex/api prisma db seed"
  }
}
