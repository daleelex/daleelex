DATABASE_URL="postgresql://daleelex:daleelex@localhost:5432/daleelex"
DALEELEX_ADMIN_API_TOKEN="change-me-for-local-admin-writes"
# Optional — defaults to http://localhost:5173 (the Vite dev server) if unset.
# Production sets this to the real site origin, e.g. https://daleelex.com
CORS_ORIGIN=""
JENKINS_BASE_URL="http://localhost:8080"
JENKINS_USERNAME=""
JENKINS_API_TOKEN=""
CLERK_SECRET_KEY=""
# Optional — Loki base URL for the service drawer's Logs tab (e.g. http://localhost:3100).
# A fallback: a Loki saved in Settings → Integrations wins. With neither, the API
# serves mock log lines. Streams are matched on the label below.
LOKI_URL=""
LOKI_SERVICE_LABEL="service_id"
