generator client {
  provider      = "prisma-client-js"
  // "native" covers wherever generate runs (dev Macs, the x86-64 CI runner);
  // the arm64 target is the production VM. Without it, `prisma generate` in
  // cd.yml only bundles the runner's own query engine and every DB-touching
  // endpoint 500s in production with "could not locate the Query Engine".
  //
  // The two -musl- targets are for the containers: the images are node:20-alpine,
  // and Alpine is musl, not glibc. The glibc targets above do not load there — same
  // "could not locate the Query Engine" failure, just inside a container. Both
  // architectures are listed because the images are built multi-arch (amd64 for
  // developer machines and CI, arm64 for the Ampere VM). Purely additive: the pm2
  // deploy path keeps using the glibc targets exactly as before.
  // Kept on one line: Prisma 5's schema parser rejects a multi-line array here.
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Team {
  id               String   @id
  name             String
  slackChannel     String?  @map("slack_channel")
  onCallSchedule   String?  @map("on_call_schedule")
  managementSource String   @map("management_source")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  services Service[]

  @@map("teams")
}

model Service {
  id               String    @id
  name             String
  description      String?
  type             String
  tier             Int
  lifecycle        String
  ownerTeamId      String?   @map("owner_team_id")
  language         String?
  repository       String?
  sloTarget        String?   @map("slo_target")
  sloWindow        String?   @map("slo_window")
  tags             String[]
  sourceSha        String?   @map("source_sha")
  managementSource String    @map("management_source")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  owner            Team?               @relation(fields: [ownerTeamId], references: [id])
  links            Link[]
  docs             ServiceDoc[]
  scorecardResults ScorecardResult[]
  dependencies     ServiceDependency[] @relation("ServiceDeps")
  dependents       ServiceDependency[] @relation("ServiceDependents")

  @@index([deletedAt, tier])
  @@index([deletedAt, ownerTeamId])
  @@index([deletedAt, type])
  @@map("services")
}

model ServiceDependency {
  serviceId   String @map("service_id")
  dependsOnId String @map("depends_on_id")

  service   Service @relation("ServiceDeps", fields: [serviceId], references: [id])
  dependsOn Service @relation("ServiceDependents", fields: [dependsOnId], references: [id])

  @@id([serviceId, dependsOnId])
  @@map("service_dependencies")
}

model Link {
  id        Int     @id @default(autoincrement())
  serviceId String  @map("service_id")
  url       String
  title     String?
  type      String  @default("other")

  service Service @relation(fields: [serviceId], references: [id])

  @@map("links")
}

model ScorecardCheck {
  id       String  @id
  label    String
  category String
  weight   Int
  enabled  Boolean @default(true)

  results ScorecardResult[]

  @@map("scorecard_checks")
}

model ScorecardResult {
  id        BigInt   @id @default(autoincrement())
  serviceId String   @map("service_id")
  checkId   String   @map("check_id")
  status    String
  message   String?
  evidence  Json?
  ranAt     DateTime @map("ran_at")

  service Service        @relation(fields: [serviceId], references: [id])
  check   ScorecardCheck @relation(fields: [checkId], references: [id])

  @@index([serviceId, checkId, ranAt(sort: Desc)])
  @@map("scorecard_results")
}

model ServiceDoc {
  id               Int      @id @default(autoincrement())
  serviceId        String   @map("service_id")
  path             String
  title            String
  contentMd        String   @map("content_md")
  sourceRepository String?  @map("source_repository")
  sourceSha        String?  @map("source_sha")
  uploadedByUserId String?  @map("uploaded_by_user_id")
  updatedByUserId  String?  @map("updated_by_user_id")
  fetchedAt        DateTime @default(now()) @map("fetched_at")

  service Service @relation(fields: [serviceId], references: [id])

  @@unique([serviceId, path])
  @@index([serviceId])
  @@map("service_docs")
}

model User {
  id         String    @id
  email      String    @unique
  name       String?
  avatarUrl  String?   @map("avatar_url")
  lastSeenAt DateTime? @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("users")
}

model IntegrationConfig {
  provider       String   @id
  baseUrl        String?  @map("base_url")
  username       String?
  encryptedToken String?  @map("encrypted_token")
  /// Provider-specific, non-secret options (e.g. Loki's service label).
  settings       Json?
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("integration_configs")
}
