# App
NODE_ENV=development
APP_PORT=5021
APP_NAME=aeon-backend

# Swagger
SWAGGER_PORT=5022

# Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://daleelex:daleelex@localhost:5432/daleelex?connection_limit=20&pool_timeout=30&connect_timeout=10"

# Admin
DALEELEX_ADMIN_API_TOKEN="change-me-for-local-admin-writes"

# Jenkins
JENKINS_BASE_URL="http://localhost:8080"
JENKINS_USERNAME=""
JENKINS_API_TOKEN=""

# Logging
LOG_LEVEL=info
LOG_ENABLE_CONSOLE=true
LOG_FILE=