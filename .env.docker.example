# Copy to `.env` at the repo root — Compose loads that file automatically and
# substitutes the values into docker-compose.yml. It is gitignored; this example is not.
#
#   cp .env.docker.example .env
#
# Everything here is optional except where noted. DATABASE_URL is deliberately absent:
# the API container always talks to the `postgres` service over the compose network,
# so it is hardcoded in docker-compose.yml rather than being made configurable.

# --- api ---

# Verifies Clerk session tokens and resolves the caller's admin role. Without it,
# guarded endpoints return 503 clerk_auth_not_configured rather than pretending the
# session is bad. Secret — this one is not publishable.
CLERK_SECRET_KEY=

# 64-character hex string (32 bytes), used to encrypt stored integration credentials.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DALEELEX_ENCRYPTION_KEY=

# Shared-secret bypass for admin API calls made outside a browser session.
DALEELEX_ADMIN_API_TOKEN=

# Browser origin allowed by CORS. Defaults to http://localhost:5173 for dev; production
# sets the real site origin.
CORS_ORIGIN=

# --- jenkins integration (all optional; the Health & SLO card degrades without them) ---
JENKINS_BASE_URL=
JENKINS_USERNAME=
JENKINS_API_TOKEN=

# --- logs (optional; without LOKI_URL the Logs tab serves mock lines) ---
# Base URL of a Loki the api container can reach, e.g. http://loki:3100.
LOKI_URL=
# Stream label that holds the catalog service ID.
LOKI_SERVICE_LABEL=service_id

# --- image tag ---
# Which published tag the prod overlay pulls from GHCR. A git SHA is the honest choice
# for a deploy; `latest` is the fallback.
DALEELEX_TAG=
